            { name: 'টেলিভিশন', watt: 80, qty: 1, hours: 4 }
        ];

        function initCalculatorRows() {
            const container = document.getElementById('applianceRows');
            container.innerHTML = '';
            defaultApplianceList.forEach((item, idx) => {
                addApplianceRow(item.name, item.watt, item.qty, item.hours);
            });
        }

        function addApplianceRow(name = '', watt = 50, qty = 1, hours = 5) {
            const container = document.getElementById('applianceRows');
            const row = document.createElement('div');
            row.className = "grid grid-cols-12 gap-2 items-center appliance-row";
            
            row.innerHTML = `
                <input type="text" value="${name}" placeholder="ডিভাইস" class="col-span-5 sm:col-span-4 p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs text-gray-900 dark:text-white border border-gray-300 dark:border-gray-700 app-name">
                <input type="number" value="${watt}" placeholder="Watt" class="col-span-3 sm:col-span-3 p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs text-gray-900 dark:text-white border border-gray-300 dark:border-gray-700 app-watt">
                <input type="number" value="${qty}" placeholder="Qty" class="col-span-2 sm:col-span-2 p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs text-gray-900 dark:text-white border border-gray-300 dark:border-gray-700 app-qty">
                <div class="col-span-2 sm:col-span-3 flex items-center space-x-1">
                    <input type="number" value="${hours}" placeholder="Hrs" class="w-full p-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs text-gray-900 dark:text-white border border-gray-300 dark:border-gray-700 app-hours">
                    <button onclick="removeRow(this)" class="p-2 text-rose-500 hover:text-rose-600"><i class="fa-solid fa-trash text-xs"></i></button>
                </div>
            `;
            container.appendChild(row);
        }

        function removeRow(btn) {
            btn.closest('.appliance-row').remove();
        }

        function calculateSolarSystem() {
            const rows = document.querySelectorAll('.appliance-row');
            let totalRunningWatt = 0;
            let totalWhPerDay = 0;

            rows.forEach(row => {
                const watt = parseFloat(row.querySelector('.app-watt').value) || 0;
                const qty = parseFloat(row.querySelector('.app-qty').value) || 0;
                const hrs = parseFloat(row.querySelector('.app-hours').value) || 0;

                totalRunningWatt += (watt * qty);
                totalWhPerDay += (watt * qty * hrs);
            });

            if (totalRunningWatt === 0) {
                alert("দয়া করে কমপক্ষে একটি ডিভাইসের তথ্য দিন।");
                return;
            }

            // Calculation Constants
            // Solar peak sun hours in BD ~ 4.5 hours
            // Safety factor 1.25 for Inverter
            const recommendedSolarWatt = Math.round((totalWhPerDay / 4.5) * 1.2);
            const recommendedInverterKVA = ((totalRunningWatt * 1.3) / 1000).toFixed(1);
            
            // Battery AH needed (assuming 24V system, 80% DOD for Lithium/Lead)
            const batteryAh24V = Math.round((totalWhPerDay / (24 * 0.8)));

            // Recommended Cable size
            let cableSize = "4.0";
            if (recommendedSolarWatt > 3000) cableSize = "6.0";
            if (recommendedSolarWatt > 6000) cableSize = "10.0";

            // Update UI Results
            document.getElementById('resTotalWatt').innerText = `${totalRunningWatt} Watt`;
            document.getElementById('resTotalWh').innerText = `${totalWhPerDay.toLocaleString()} Wh / দিন`;
            document.getElementById('resSolarPanel').innerText = `${recommendedSolarWatt} Watt`;
            document.getElementById('resInverter').innerText = `${recommendedInverterKVA} kVA / kW`;
            document.getElementById('resBattery').innerText = `${batteryAh24V} Ah (24V)`;
            document.getElementById('resCable').innerText = `${cableSize} Sq-mm Solar Cable`;

            document.getElementById('calcResults').classList.remove('hidden');
        }

        // Tab Switcher
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabName}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-amber-500', 'bg-amber-500/10');
                btn.classList.add('text-gray-600', 'dark:text-gray-300');
            });

            const activeBtn = document.getElementById(`nav-${tabName}`);
            if (activeBtn) {
                activeBtn.classList.add('text-amber-500', 'bg-amber-500/10');
                activeBtn.classList.remove('text-gray-600', 'dark:text-gray-300');
            }
        }

        // Theme Toggle (Dark/Light)
        function toggleTheme() {
            const html = document.documentElement;
            const icon = document.getElementById('themeIcon');

            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                html.classList.add('dark');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }

        // Developer Modal Toggle
        function toggleDevModal() {
            const modal = document.getElementById('devModal');
            modal.classList.toggle('hidden');
        }
    </script>
</body>
</html>
