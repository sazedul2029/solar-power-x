<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solar Power X - Advanced Solar Knowledge & Calculator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fffbebe',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-slate-800/90 backdrop-blur border-b border-slate-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Brand Logo -->
                <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('articles')">
                    <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center text-slate-900 font-black text-xl shadow-lg shadow-amber-500/20">
                        X
                    </div>
                    <div>
                        <span class="text-xl font-bold bg-gradient-to-r from-amber-400 to-orange-500 bg-clip-text text-transparent">Solar Power X</span>
                        <p class="text-[10px] text-slate-400 tracking-wider">NEXT-GEN ENERGY SOLUTION</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex space-x-2">
                    <button onclick="switchTab('articles')" id="nav-articles" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-amber-500 text-slate-900">
                        <i class="fa-solid fa-newspaper mr-2"></i>Articles & Guides
                    </button>
                    <button onclick="switchTab('calculator')" id="nav-calculator" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-amber-400 hover:bg-slate-700/50 transition-colors">
                        <i class="fa-solid fa-calculator mr-2"></i>Solar Calculator
                    </button>
                </nav>

                <!-- Actions -->
                <div class="flex items-center gap-3">
                    <button id="adminBtn" onclick="toggleAdminModal()" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-semibold flex items-center gap-2 border border-slate-600">
                        <i class="fa-solid fa-lock text-amber-400"></i> Admin Access
                    </button>
                    <button onclick="toggleDevModal()" class="w-10 h-10 rounded-lg bg-slate-700 hover:bg-slate-600 flex items-center justify-center text-slate-300 border border-slate-600" title="Developer Info">
                        <i class="fa-solid fa-ellipsis-vertical text-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ARTICLES SECTION -->
        <section id="section-articles" class="space-y-6">
            <div class="flex justify-between items-center flex-wrap gap-4 border-b border-slate-800 pb-4">
                <div>
                    <h1 class="text-2xl font-bold text-white">Solar Knowledge Center</h1>
                    <p class="text-sm text-slate-400">Explore technical guides on Panels, Inverters, Batteries, Cable Sizing, and Protections.</p>
                </div>
                <button id="addPostBtn" onclick="openPostModal()" class="hidden px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-lg text-sm transition-all flex items-center gap-2 shadow-lg shadow-amber-500/20">
                    <i class="fa-solid fa-plus"></i> Add New Article
                </button>
            </div>

            <!-- Category Filters -->
            <div class="flex flex-wrap gap-2" id="categoryFilters">
                <button onclick="filterCategory('All')" class="px-3 py-1.5 rounded-full text-xs font-medium bg-amber-500 text-slate-900 filter-btn">All Topics</button>
                <button onclick="filterCategory('Solar Panels')" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-800 text-slate-400 hover:text-white filter-btn">Solar Panels</button>
                <button onclick="filterCategory('Inverters')" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-800 text-slate-400 hover:text-white filter-btn">Inverters</button>
                <button onclick="filterCategory('Batteries')" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-800 text-slate-400 hover:text-white filter-btn">Batteries</button>
                <button onclick="filterCategory('Cable Sizing')" class="px-3 py-1.5 rounded-full text-xs font-medium bg-slate-800 text-slate-400 hover:text-white filter-btn">Cable Sizing & Protections</button>
            </div>

            <!-- Articles Grid -->
            <div id="articlesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Dynamic Content Will Be Rendered Here -->
            </div>
        </section>

        <!-- CALCULATOR SECTION -->
        <section id="section-calculator" class="hidden space-y-6">
            <div class="border-b border-slate-800 pb-4">
                <h1 class="text-2xl font-bold text-white">Solar System Load Calculator</h1>
                <p class="text-sm text-slate-400">Add your appliances with Wattage, Quantity, and daily Usage Hours to calculate your solar requirements.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Appliance Input Form -->
                <div class="lg:col-span-2 bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 space-y-6">
                    <h2 class="text-lg font-semibold text-amber-400 flex items-center gap-2">
                        <i class="fa-solid fa-plug"></i> Add Electrical Appliances
                    </h2>

                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                        <div class="sm:col-span-1">
                            <label class="block text-xs font-medium text-slate-400 mb-1">Appliance Name</label>
                            <input type="text" id="applianceName" placeholder="e.g. Ceiling Fan" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Watts (W)</label>
                            <input type="number" id="applianceWatt" placeholder="75" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Quantity</label>
                            <input type="number" id="applianceQty" placeholder="1" value="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Hours / Day</label>
                            <input type="number" id="applianceHours" placeholder="8" value="6" step="0.5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                        </div>
                    </div>

                    <button onclick="addAppliance()" class="w-full py-2.5 bg-slate-700 hover:bg-slate-600 text-amber-400 border border-amber-500/30 font-semibold rounded-lg text-sm transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus"></i> Add Item to List
                    </button>

                    <!-- Appliance Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-300">
                            <thead class="bg-slate-900/80 text-xs text-slate-400 uppercase">
                                <tr>
                                    <th class="p-3">Appliance</th>
                                    <th class="p-3">Power</th>
                                    <th class="p-3">Qty</th>
                                    <th class="p-3">Hours</th>
                                    <th class="p-3">Total Energy</th>
                                    <th class="p-3 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="applianceTableBody" class="divide-y divide-slate-700/50">
                                <!-- Dynamic Items -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Calculation Summary -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 space-y-6 flex flex-col justify-between">
                    <div>
                        <h2 class="text-lg font-semibold text-amber-400 mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-chart-pie"></i> System Recommendation
                        </h2>

                        <div class="space-y-4">
                            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700">
                                <span class="text-xs text-slate-400 block">Total Peak Power</span>
                                <span id="resTotalPower" class="text-2xl font-black text-amber-400">0 W</span>
                            </div>

                            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700">
                                <span class="text-xs text-slate-400 block">Daily Energy Consumption</span>
                                <span id="resTotalEnergy" class="text-2xl font-black text-amber-400">0 Wh / day</span>
                            </div>

                            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700">
                                <span class="text-xs text-slate-400 block">Recommended Inverter Rating</span>
                                <span id="resInverter" class="text-xl font-bold text-slate-200">0 kVA</span>
                            </div>

                            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700">
                                <span class="text-xs text-slate-400 block">Recommended Solar Panels</span>
                                <span id="resPanels" class="text-xl font-bold text-slate-200">0 Watt Total</span>
                            </div>

                            <div class="p-4 bg-slate-900/60 rounded-xl border border-slate-700">
                                <span class="text-xs text-slate-400 block">Battery Bank Required (12V)</span>
                                <span id="resBattery" class="text-xl font-bold text-slate-200">0 Ah</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ADMIN LOGIN MODAL -->
    <div id="adminModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-sm w-full p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 class="text-lg font-bold text-white"><i class="fa-solid fa-user-shield text-amber-400 mr-2"></i>Admin Authentication</h3>
                <button onclick="toggleAdminModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Enter Admin Password</label>
                <input type="password" id="adminPasswordInput" placeholder="Password" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                <p id="adminErrorMsg" class="text-xs text-red-400 mt-1 hidden">Invalid Password!</p>
            </div>
            <div class="flex gap-2">
                <button onclick="loginAdmin()" class="w-full py-2 bg-amber-500 text-slate-900 font-bold rounded-lg text-sm hover:bg-amber-600 transition-all">Login</button>
            </div>
        </div>
    </div>

    <!-- POST ADD/EDIT MODAL -->
    <div id="postModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-700 pb-3">
                <h3 id="postModalTitle" class="text-lg font-bold text-white">Add New Article</h3>
                <button onclick="closePostModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="postForm" onsubmit="handlePostSubmit(event)" class="space-y-3">
                <input type="hidden" id="postId">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Article Title</label>
                    <input type="text" id="postTitle" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Category</label>
                    <select id="postCategory" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                        <option value="Solar Panels">Solar Panels</option>
                        <option value="Inverters">Inverters</option>
                        <option value="Batteries">Batteries</option>
                        <option value="Cable Sizing">Cable Sizing & Protections</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Thumbnail Image URL</label>
                    <input type="url" id="postImage" required placeholder="https://images.unsplash.com/..." class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Content/Description</label>
                    <textarea id="postContent" rows="4" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500"></textarea>
                </div>
                <button type="submit" class="w-full py-2 bg-amber-500 text-slate-900 font-bold rounded-lg text-sm hover:bg-amber-600 transition-all">Save Article</button>
            </form>
        </div>
    </div>

    <!-- DEVELOPER INFO MODAL -->
    <div id="devModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl max-w-sm w-full p-6 space-y-4 text-center shadow-2xl relative">
            <button onclick="toggleDevModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            <div class="w-20 h-20 bg-amber-500 rounded-full mx-auto flex items-center justify-center text-slate-900 font-black text-3xl shadow-lg shadow-amber-500/30">
                SH
            </div>
            <div>
                <h3 class="text-xl font-bold text-white">MD SAZEDUL HAQUE</h3>
                <p class="text-xs text-amber-400 font-medium mt-1">Lead Developer & Energy Consultant</p>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed">
                Specialized in Hybrid & Off-grid Solar System Engineering, Load Calculations, and Modern Web Applications.
            </p>
            <div class="pt-2 border-t border-slate-700 text-xs text-slate-500">
                © 2026 Solar Power X. All rights reserved.
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            <p>Designed & Developed by <span class="text-amber-400 font-semibold">MD SAZEDUL HAQUE</span></p>
        </div>
    </footer>

