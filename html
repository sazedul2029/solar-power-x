        // Save / Update Article to LocalStorage
        function saveArticle(event) {
            event.preventDefault();

            const editId = document.getElementById('editArticleId').value;
            const title = document.getElementById('postTitle').value;
            const category = document.getElementById('postCategory').value;
            const img = document.getElementById('postImg').value || 'https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?auto=format&fit=crop&w=600&q=80';
            const excerpt = document.getElementById('postExcerpt').value;
            const content = document.getElementById('postContent').value;

            if (editId) {
                // Edit mode
                const index = articles.findIndex(a => a.id === editId);
                if (index !== -1) {
                    articles[index] = {
                        ...articles[index],
                        title, category, img, excerpt, content
                    };
                }
            } else {
                // New post mode
                const newArticle = {
                    id: 'art-' + Date.now(),
                    title,
                    category,
                    img,
                    excerpt,
                    content,
                    date: new Date().toISOString().split('T')[0],
                    readTime: '৪ মিনিট'
                };
                articles.unshift(newArticle);
            }

            localStorage.setItem('spx_articles', JSON.stringify(articles));
            renderArticles();
            updateStats();
            closeAddPostModal();
        }

